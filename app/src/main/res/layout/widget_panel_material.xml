<?xml version="1.0" encoding="utf-8"?>
<!-- Material You widget layout (Android 12+) — 28dp radius, 16dp outer padding per guidelines -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_material"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="top">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="panel.example.com"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/w_uptime_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12d 3h"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF"
                    android:maxLines="1" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="#66FFFFFF" />

                <TextView
                    android:id="@+id/w_updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5m ago"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/w_offline_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/widget_badge_offline_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/w_refresh"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_refresh"
                android:contentDescription="@string/widget_refresh" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/widget_divider" />

    <!-- ROW 1: Online / Total / Active -->
    <LinearLayout
        android:id="@+id/w_row_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:id="@+id/w_tile_online"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_tile_accent_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/w_online_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_online"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_tile_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/w_total_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="128"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wg_total_users"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_tile_active"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/w_active_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="96"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wg_active"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ROW 2: Expired / Limited / Disabled -->
    <LinearLayout
        android:id="@+id/w_row_status2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/w_expired_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expired"
                android:textSize="10sp"
                android:textColor="#99FFFFFF"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/w_limited_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/limited"
                android:textSize="10sp"
                android:textColor="#99FFFFFF"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/w_disabled_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/disabled"
                android:textSize="10sp"
                android:textColor="#99FFFFFF"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ROW 3: OnHold / Debtors / Traffic -->
    <LinearLayout
        android:id="@+id/w_row_status3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/w_onhold_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/on_hold"
                android:textSize="10sp"
                android:textColor="#99FFFFFF"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_tile_debtors"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/w_debtors_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debtors"
                android:textSize="10sp"
                android:textColor="#99FFFFFF"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/w_traffic_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.2 TB"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/w_traffic_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wg_traffic"
                android:textSize="10sp"
                android:textColor="#99FFFFFF"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ROW 4: Resources -->
    <LinearLayout
        android:id="@+id/w_row_resources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wg_cpu"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF" />

                <TextView
                    android:id="@+id/w_cpu_val"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="42%"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:gravity="end" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/w_cpu_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="42"
                android:progressDrawable="@drawable/widget_progress_fill" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wg_ram"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF" />

                <TextView
                    android:id="@+id/w_ram_val"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="68%"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:gravity="end" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/w_ram_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="68"
                android:progressDrawable="@drawable/widget_progress_fill" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_tile_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wg_disk"
                    android:textSize="10sp"
                    android:textColor="#99FFFFFF" />

                <TextView
                    android:id="@+id/w_disk_val"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="51%"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:gravity="end" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/w_disk_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="51"
                android:progressDrawable="@drawable/widget_progress_fill" />
        </LinearLayout>
    </LinearLayout>

    <!-- ROW 5: Bandwidth -->
    <LinearLayout
        android:id="@+id/w_row_traffic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_tile_bg"
        android:padding="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓"
            android:textSize="11sp"
            android:textColor="#99FFFFFF" />

        <TextView
            android:id="@+id/w_incoming_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12.4 GB"
            android:textSize="11sp"
            android:textColor="#FFFFFFFF"
            android:layout_marginStart="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↑"
            android:textSize="11sp"
            android:textColor="#99FFFFFF"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/w_outgoing_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="48.2 GB"
            android:textSize="11sp"
            android:textColor="#FFFFFFFF"
            android:layout_marginStart="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_cores_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 cores"
            android:textSize="10sp"
            android:textColor="#66FFFFFF" />
    </LinearLayout>

</LinearLayout>
